# Config changes taken from pkenti's exynos850-a13nsxx_defconfig (A135F, same 4.19.325 base).
# Left out on purpose: identity/boot lines (LOCALVERSION, CMDLINE, SELinux, KSU), the CPU governors
# (cpu_governor step), TEO (cpu_idle_teo step), and options his tree does not have at all.
# CONFIG_ARM64_SW_TTBR0_PAN is not set
CONFIG_BLK_DEV_IO_TRACE=y
CONFIG_BPF_PRELOAD=y
CONFIG_BRIDGE=y
CONFIG_CGROUP_DEVICE=y
# CONFIG_CONTEXTHUB_DEBUG is not set
# CONFIG_CPU_FREQ_STAT is not set
CONFIG_CRYPTO_LZ4=y
# CONFIG_CRYPTO_LZO is not set
# CONFIG_DEBUG_INFO is not set
CONFIG_DEFAULT_BBR=y
# CONFIG_DEFAULT_BIC is not set
CONFIG_DEFAULT_FQ_CODEL=y
CONFIG_DEFAULT_NET_SCH="fq_codel"
CONFIG_DEFAULT_TCP_CONG="bbr"
CONFIG_HZ=300
# CONFIG_HZ_250 is not set
CONFIG_HZ_300=y
# CONFIG_INIT_STACK_ALL_ZERO is not set
CONFIG_IPC_NS=y
# CONFIG_KERNEL_GZIP is not set
CONFIG_KERNEL_LZ4=y
CONFIG_KEXEC=y
CONFIG_KSM=y
CONFIG_MMAP_READAROUND_LIMIT=16
# CONFIG_MMC_DW_DEBUG is not set
# CONFIG_MSDOS_FS is not set
CONFIG_NET_SCH_DEFAULT=y
CONFIG_NET_SCH_FQ=y
CONFIG_NET_SCH_FQ_CODEL=y
# CONFIG_NET_SCH_TBF is not set
# CONFIG_NTFS_DEBUG is not set
# CONFIG_PM_DEBUG is not set
# CONFIG_PM_SLEEP_DEBUG is not set
# CONFIG_PROFILING is not set
# CONFIG_REFCOUNT_FULL is not set
CONFIG_RELAY=y
# CONFIG_SCHED_DEBUG is not set
# CONFIG_SCSC_WLAN_MUTEX_DEBUG is not set
CONFIG_SDFAT_USE_FOR_EXFAT=y
CONFIG_SDFAT_USE_FOR_VFAT=y
# CONFIG_SEC_DEBUG_BAD_STACK_CAREFULLY is not set
# CONFIG_SEC_DEBUG_BAD_STACK_INFO is not set
# CONFIG_SEC_DEBUG_EXCEPTION_STACK is not set
# CONFIG_SEC_DEBUG_FPSIMD_CHECK_CONTEXT is not set
# CONFIG_SEC_DEBUG_LOCKUP_INFO is not set
# CONFIG_SEC_DEBUG_PM_DEVICE_INFO is not set
# CONFIG_SEC_DEBUG_SYSRQ_KMSG is not set
# CONFIG_SLUB_DEBUG is not set
# CONFIG_SOC_EXYNOS3830_ANDROID_VERSION_S is not set
CONFIG_SYSVIPC=y
CONFIG_USB_CONFIGFS_F_ADB=y
# CONFIG_VFAT_FS is not set
CONFIG_WQ_POWER_EFFICIENT_DEFAULT=y
CONFIG_ZRAM_MEMORY_TRACKING=y
